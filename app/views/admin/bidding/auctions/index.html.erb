<% content_for :title, "Auctions" %>
<div class="bidding-head">
  <h1>Auctions</h1>
  <%= link_to new_admin_bidding_auction_path, class: "bidding-btn bidding-btn--primary" do %><%= bidding_icon(:plus) %>New auction<% end %>
</div>

<%= form_with url: admin_bidding_auctions_path, method: :get, class: "bidding-head" do %>
  <div class="bidding-field">
    <label for="status">Filter by status</label>
    <%= select_tag :status, options_for_select([["All", ""]] + BiddingHelper::STATUS_LABELS.map { |k, v| [v, k] }, @status), onchange: "this.form.requestSubmit()" %>
  </div>
  <noscript><button class="bidding-btn">Filter</button></noscript>
<% end %>

<div class="bidding-card bidding-card--scroll">
  <% if @auctions.empty? %>
    <p class="bidding-hint">No auctions<%= " with this status" if @status %> yet. Press “New auction” to start.</p>
  <% else %>
    <table class="bidding-table">
      <thead><tr><th>Auction</th><th>Opens</th><th>Closes</th><th>Type</th><th>Lots</th><th>Status</th><th><span class="bidding-sr-only">Actions</span></th></tr></thead>
      <tbody>
        <% @auctions.each do |a| %>
          <tr>
            <td><strong><%= a.title %></strong></td>
            <td class="bidding-mono"><%= bidding_time(a.starts_at) %></td>
            <td class="bidding-mono"><%= bidding_time(a.ends_at) %></td>
            <td><%= bidding_type_label(a) %></td>
            <td class="bidding-mono"><%= a.lots.size %>/<%= Auction::MAX_LOTS %></td>
            <td><%= bidding_status_chip(a) %></td>
            <td><%= link_to(a.draft? ? "Edit" : "View", admin_bidding_auction_path(a)) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>

<nav class="bidding-actions" aria-label="Pages">
  <% if @page > 1 %><%= link_to admin_bidding_auctions_path(status: @status, page: @page - 1), class: "bidding-btn" do %><%= bidding_icon(:arrow_left) %>Previous<% end %><% end %>
  <% if @next_page %><%= link_to admin_bidding_auctions_path(status: @status, page: @page + 1), class: "bidding-btn" do %>Next<%= bidding_icon(:arrow_right) %><% end %><% end %>
</nav>
