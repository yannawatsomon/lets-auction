<% content_for :title, @auction.title %>
<%= link_to admin_bidding_auctions_path, class: "bidding-btn bidding-btn--link" do %><%= bidding_icon(:arrow_left) %>Back to auctions<% end %>

<div class="bidding-head">
  <div class="bidding-stack">
    <div class="bidding-badges">
      <span class="bidding-chip bidding-chip--type"><%= bidding_type_label(@auction) %></span>
      <%= bidding_status_chip(@auction) %>
    </div>
    <h1><%= @auction.title %></h1>
  </div>
  <% if @auction.awaiting_approval? || @auction.published? %>
    <div class="bidding-actions"><%= link_to(@auction.awaiting_approval? ? "Review ranking and publish" : "Results and payments", results_admin_bidding_auction_path(@auction), class: "bidding-btn bidding-btn--primary") %></div>
  <% end %>
  <% if @auction.draft? %>
    <div class="bidding-actions">
      <%= link_to "Edit details", edit_admin_bidding_auction_path(@auction), class: "bidding-btn" %>
      <%= button_to "Publish auction", schedule_admin_bidding_auction_path(@auction), class: "bidding-btn bidding-btn--primary",
            disabled: @auction.lots.empty?,
            form: { data: { turbo_confirm: "After publishing you can't edit the auction or its lots. Publish?" } } %>
    </div>
  <% end %>
</div>

<div class="bidding-stats">
  <div class="bidding-stat"><div class="bidding-stat__k">Opens</div><div class="bidding-stat__v"><%= bidding_time(@auction.starts_at) %></div></div>
  <div class="bidding-stat"><div class="bidding-stat__k">Closes</div><div class="bidding-stat__v"><%= bidding_time(@auction.ends_at) %></div></div>
  <div class="bidding-stat"><div class="bidding-stat__k">Who can join</div><div class="bidding-stat__v"><%= @auction.english? ? "Invite only" : "Buyers register" %></div></div>
  <div class="bidding-stat"><div class="bidding-stat__k">Closing</div><div class="bidding-stat__v">All lots close together, no extensions</div></div>
</div>
<% if @auction.description.present? %><p class="bidding-hint"><%= @auction.description %></p><% end %>
<% if @auction.cancelled? %>
  <div class="bidding-flash bidding-flash--alert"><%= bidding_icon(:alert) %><span>Cancelled <%= bidding_time(@auction.cancelled_at) %> · Reason: <%= @auction.cancel_reason %></span></div>
<% end %>

<div class="bidding-row">
  <section class="bidding-card" aria-labelledby="lots-h">
    <div class="bidding-head">
      <h2 id="lots-h">Lots</h2>
      <span class="bidding-count <%= 'bidding-count--full' if @auction.lots_full? %>"><%= @auction.lots.size %>/<%= Auction::MAX_LOTS %></span>
    </div>
    <% if @auction.lots.empty? %>
      <p class="bidding-hint">No lots yet. Pick from approved items.</p>
    <% end %>
    <% @auction.lots.each do |lot| %>
      <div class="bidding-pick bidding-pick--in">
        <span class="bidding-pick__thumb" aria-hidden="true"></span>
        <span class="bidding-pick__body">
          <span class="bidding-pick__title">Lot <%= lot.lot_no %> · <%= lot.item&.title || "Item ##{lot.item_id}" %></span>
          <span class="bidding-pick__sub">Starting price <%= bidding_baht(lot.min_price_cents) %><%= " · increment #{bidding_baht(lot.bid_increment_cents)}" if lot.bid_increment_cents %></span>
        </span>
        <% if @auction.draft? %>
          <%= button_to admin_bidding_auction_lot_path(@auction, lot), method: :delete, class: "bidding-btn", "aria-label": "Remove lot #{lot.lot_no}" do %><%= bidding_icon(:x) %>Remove<% end %>
        <% end %>
      </div>
    <% end %>
  </section>

  <% if @auction.draft? %>
    <section class="bidding-card" aria-labelledby="pool-h">
      <h2 id="pool-h">Add items</h2>
      <p class="bidding-hint">Pick from approved items (up to <%= Auction::MAX_LOTS %>)<%= ". English lots need a bid increment" if @auction.english? %></p>
      <% if @available_items.empty? %><p class="bidding-hint">No approved items to pick.</p><% end %>
      <% @available_items.each do |item| %>
        <% busy = @busy_item_ids.include?(item.id) %>
        <div class="bidding-pick">
          <span class="bidding-pick__thumb" aria-hidden="true"></span>
          <span class="bidding-pick__body">
            <span class="bidding-pick__title"><%= item.title %></span>
            <span class="bidding-pick__sub"><%= AuctionItems.seller(item)&.display_name %> · <%= item.category %> · starting <%= bidding_baht(item.min_price_cents) %><%= " · in another auction that hasn't ended" if busy %></span>
          </span>
          <%= form_with url: admin_bidding_auction_lots_path(@auction), method: :post do %>
            <%= hidden_field_tag :item_id, item.id, id: nil %>
            <% if @auction.english? %>
              <label class="bidding-sr-only" for="inc-<%= item.id %>">Bid increment (THB) for <%= item.title %></label>
              <input id="inc-<%= item.id %>" name="bid_increment" inputmode="decimal" placeholder="Increment (THB)" required>
            <% end %>
            <button class="bidding-btn" <%= "disabled" if busy || @auction.lots_full? %>><%= bidding_icon(:plus) %>Add</button>
          <% end %>
        </div>
      <% end %>
    </section>
  <% end %>
</div>

<section class="bidding-card" aria-labelledby="people-h">
  <div class="bidding-head">
    <h2 id="people-h"><%= @auction.english? ? "Invited buyers" : "Registered buyers" %></h2>
    <span class="bidding-count"><%= pluralize(@participants.count { |p| !p.revoked? }, "buyer") %></span>
  </div>
  <p class="bidding-hint">
    <% if @auction.english? %>
      Only grade A buyers with approved proof of income can be invited. Buyers accept before they can bid. Invite or revoke before the auction opens.
    <% else %>
      Buyers register themselves once the auction is published (onboarding done, grade A–D).
    <% end %>
  </p>
  <% if @participants.empty? %><p class="bidding-hint">None yet.</p><% end %>
  <% @participants.each do |p| %>
    <div class="bidding-pick <%= 'bidding-pick--in' unless p.revoked? %>">
      <span class="bidding-pick__body">
        <span class="bidding-pick__title"><%= p.user&.display_name || "User ##{p.user_id}" %></span>
        <span class="bidding-pick__sub">Grade at entry <%= p.grade_at_entry %> · <%= BiddingHelper::PARTICIPANT_LABELS.fetch(p.status) %></span>
      </span>
      <% if !p.revoked? && (@auction.draft? || @auction.scheduled?) %>
        <%= button_to "Revoke", revoke_admin_bidding_auction_invitation_path(@auction, p), class: "bidding-btn",
              form: { data: { turbo_confirm: "Revoke this buyer's access?" } } %>
      <% end %>
    </div>
  <% end %>

  <% if @auction.english? && (@auction.draft? || @auction.scheduled?) %>
    <h2>Invite buyers</h2>
    <% if @invitable_users.empty? %><p class="bidding-hint">No grade A buyers with approved proof of income left to invite.</p><% end %>
    <% @invitable_users.each do |u| %>
      <div class="bidding-pick">
        <span class="bidding-pick__body"><span class="bidding-pick__title"><%= u.display_name %></span><span class="bidding-pick__sub">Grade <%= BuyerStanding.grade(u) %> · proof of income approved</span></span>
        <%= button_to admin_bidding_auction_invitations_path(@auction, user_id: u.id), class: "bidding-btn" do %><%= bidding_icon(:user_plus) %>Invite<% end %>
      </div>
    <% end %>
  <% end %>
</section>

<% if @auction.draft? || @auction.scheduled? %>
  <section class="bidding-card" aria-labelledby="cancel-h">
    <h2 id="cancel-h">Cancel auction</h2>
    <%= form_with url: cancel_admin_bidding_auction_path(@auction), method: :post, class: "bidding-field" do %>
      <label for="cancel_reason">Reason (required)</label>
      <textarea id="cancel_reason" name="cancel_reason" rows="2" required></textarea>
      <div class="bidding-actions"><button class="bidding-btn bidding-btn--danger" data-turbo-confirm="Cancel this auction? This can't be undone.">Cancel auction</button></div>
    <% end %>
  </section>
<% end %>
