<% content_for :title, "Results · #{@auction.title}" %>
<%= link_to admin_bidding_auction_path(@auction), class: "bidding-btn bidding-btn--link" do %><%= bidding_icon(:arrow_left) %>Back to the auction<% end %>
<div class="bidding-head">
  <div class="bidding-stack">
    <div class="bidding-badges"><span class="bidding-chip bidding-chip--type"><%= bidding_type_label(@auction) %></span><%= bidding_status_chip(@auction) %></div>
    <h1>Results · <%= @auction.title %></h1>
    <p class="bidding-hint">Closed <%= bidding_time(@auction.ends_at) %> · ranked high to low, ties go to the earlier bid<%= " · English counts each bidder's highest bid" if @auction.english? %> · opening this page is recorded in the audit log</p>
  </div>
  <% if @auction.awaiting_approval? %>
    <%= button_to approve_results_admin_bidding_auction_path(@auction), class: "bidding-btn bidding-btn--primary",
          form: { data: { turbo_confirm: "Approve results for every lot and notify the winners? This can't be undone." } } do %><%= bidding_icon(:circle_check) %>Approve and publish results<% end %>
  <% end %>
</div>

<% @lots.each do |lot| %>
  <% results = lot.results %>
  <% skips = Bidding::OrderStore.disqualified(lot.id) %>
  <% orders = Bidding::OrderStore.for_lot(lot.id) %>
  <section class="bidding-card bidding-card--scroll" aria-labelledby="lot-<%= lot.id %>">
    <div class="bidding-head">
      <h2 id="lot-<%= lot.id %>">Lot <%= lot.lot_no %> · <%= lot.item&.title || "Item ##{lot.item_id}" %></h2>
      <span class="bidding-hint">Starting price <%= bidding_baht(lot.min_price_cents) %> · <%= pluralize(results.size, "bidder") %> · lot status: <%= lot.status %></span>
    </div>
    <% if results.empty? %>
      <p class="bidding-hint">No bids. This lot didn't sell (the item is back to approved).</p>
    <% else %>
      <table class="bidding-table">
        <thead><tr><th>Rank</th><th>Bidder</th><th>Amount</th><th>Placed (server time)</th><th>Status</th><th><span class="bidding-sr-only">Actions</span></th></tr></thead>
        <tbody>
          <% results.each do |r| %>
            <% order = orders.find { |o| o.buyer_id == r.user_id } %>
            <tr>
              <td class="bidding-mono"><strong><%= r.rank %></strong></td>
              <td><%= r.user&.display_name || "User ##{r.user_id}" %></td>
              <td class="bidding-mono"><%= bidding_baht(r.amount_cents) %></td>
              <td class="bidding-mono"><%= r.bid.created_at.in_time_zone.strftime("%d/%m %H:%M:%S.%L") %></td>
              <td>
                <% if skips[r.user_id] %>Disqualified · <%= skips[r.user_id] %>
                <% elsif order %><%= { "awaiting_payment" => "Awaiting payment until #{bidding_time(order.payment_due_at)}", "paid" => "Paid", "expired" => "Didn't pay in time", "declined" => "Declined" }.fetch(order.status) %>
                <% elsif @auction.awaiting_approval? && r.rank == (results.map(&:rank) - results.select { |x| skips[x.user_id] }.map(&:rank)).min %>Gets the offer on approval
                <% else %>Backup<% end %>
              </td>
              <td>
                <% if @auction.awaiting_approval? && !skips[r.user_id] %>
                  <%= form_with url: disqualify_admin_bidding_auction_lot_path(@auction, lot), method: :post, class: "bidding-inline-form" do %>
                    <%= hidden_field_tag :user_id, r.user_id, id: nil %>
                    <label class="bidding-sr-only" for="dq-<%= lot.id %>-<%= r.user_id %>">Reason for disqualifying</label>
                    <input id="dq-<%= lot.id %>-<%= r.user_id %>" name="reason" required maxlength="500" placeholder="Reason">
                    <button class="bidding-btn bidding-btn--danger">Disqualify</button>
                  <% end %>
                <% elsif order&.awaiting_payment? %>
                  <%= button_to "Mark as paid (mock)", mark_paid_admin_bidding_order_path(order.id), class: "bidding-btn" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </section>
<% end %>
<p class="bidding-hint">The winner pays within 48 hours. If they don't pay or decline, the next rank is offered the lot at their own bid. Offers and payment status are mock data (lost on restart).</p>
