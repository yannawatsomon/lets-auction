<%= form_with model: [:admin, auction], class: "card" do |f| %>
  <h2>ข้อมูลงาน</h2>
  <% if auction.errors[:base].any? %><div class="flash alert" role="alert"><%= auction.errors[:base].to_sentence %></div><% end %>

  <div class="field">
    <%= f.label :title, "ชื่องาน *" %>
    <%= f.text_field :title, required: true, maxlength: 200, "aria-invalid": auction.errors[:title].any? %>
    <% auction.errors[:title].each do |m| %><span class="field-error"><%= m %></span><% end %>
  </div>

  <div class="field">
    <%= f.label :description, "รายละเอียดงาน" %>
    <%= f.text_area :description, rows: 3 %>
  </div>

  <div class="field">
    <%= f.label :auction_type, "วิธีประมูล *" %>
    <%= f.select :auction_type, AuctionsHelper::TYPE_LABELS.map { |k, v| [v, k] }, {}, disabled: auction.lots.any? %>
    <span class="hint">English เป็นแบบเชิญเท่านั้นเสมอ<%= " · เปลี่ยนวิธีไม่ได้เมื่อมีสินค้าในงานแล้ว" if auction.lots.any? %></span>
  </div>

  <div class="fields-2">
    <div class="field">
      <%= f.label :starts_at, "เริ่มประมูล *" %>
      <%= f.datetime_local_field :starts_at, value: datetime_field_value(auction.starts_at), required: true %>
      <% auction.errors[:starts_at].each do |m| %><span class="field-error"><%= m %></span><% end %>
    </div>
    <div class="field">
      <%= f.label :ends_at, "ปิดประมูล *" %>
      <%= f.datetime_local_field :ends_at, value: datetime_field_value(auction.ends_at), required: true %>
      <% auction.errors[:ends_at].each do |m| %><span class="field-error"><%= m %></span><% end %>
    </div>
  </div>
  <span class="hint">เวลาเป็นเวลาไทย (Asia/Bangkok) และระบบใช้เวลาของ server เท่านั้น</span>

  <div class="actions">
    <%= link_to "ยกเลิก", auction.persisted? ? admin_auction_path(auction) : admin_auctions_path, class: "btn" %>
    <%= f.submit auction.persisted? ? "บันทึก" : "บันทึกร่าง", class: "btn primary" %>
  </div>
<% end %>
