<% content_for :title, "ลงทะเบียนผู้ซื้อ" %>
<% done = onboarding_done_count(@onboarding) %>
<% next_step = onboarding_next_step(@onboarding) %>
<%= render "onboarding/intro" %>
<%= render "onboarding/steps", onboarding: @onboarding, current: next_step %>

<% if @onboarding.status.in?(%w[scored completed]) && @assessment %>
  <section class="card ob-card">
    <h2>ผลการประเมิน</h2>
    <%= render "onboarding/score_result", assessment: @assessment %>
  </section>
<% end %>

<section class="card ob-card">
  <h2>ขั้นตอนของคุณ</h2>
  <ol class="ob-list">
    <% OnboardingsHelper::STEP_LABELS.each.with_index(1) do |label, n| %>
      <li>
        <span class="n"><%= n %></span>
        <span class="body">
          <span class="title"><%= label %></span>
          <% if n == 1 && @onboarding.national_id.present? %>
            <span class="sub"><%= ThaiNationalId.mask(@onboarding.national_id) %> · <%= @onboarding.phone %></span>
          <% end %>
          <% if n == 2 && @onboarding.occupation.present? %>
            <span class="sub"><%= UserOnboarding::OCCUPATION_LABELS[@onboarding.occupation] %> · <%= number_with_delimiter(@onboarding.monthly_income) %> บาท/เดือน · <%= @onboarding.years_experience_total %> ปี</span>
          <% end %>
        </span>
        <span class="chip <%= n <= done ? "ob-done" : "ob-todo" %>"><%= n <= done ? "เสร็จแล้ว" : "ยังไม่ได้ทำ" %></span>
        <% step_path = { 1 => edit_onboarding_identity_path, 2 => edit_onboarding_employment_path, 3 => onboarding_score_path, 4 => onboarding_confirmation_path }[n] %>
        <% if step_path && n <= (next_step || 4) %>
          <%= link_to (n <= done ? (n >= 3 ? "ดูผล" : "แก้ไข") : (n == 4 ? "ยืนยัน" : "เริ่ม")), step_path, class: (n == next_step ? "btn primary" : "btn") %>
        <% elsif step_path %>
          <span class="hint ob-soon">ทำขั้นก่อนหน้าก่อน</span>
        <% else %>
          <span class="hint ob-soon">เร็วๆ นี้</span>
        <% end %>
      </li>
    <% end %>
  </ol>
</section>
