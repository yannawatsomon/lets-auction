<%# locals: (lot:, status:, auction_type:, image_path: nil, detail_path: nil, min_price_cents: nil) %>
<% status_label = catalog_status_label(status) %>
<% auction_label = catalog_auction_label(auction_type) %>
<% image_source = catalog_local_path(image_path) %>
<% destination = catalog_local_path(detail_path) %>
<% detail_heading = "catalog-detail-#{SecureRandom.hex(6)}" %>
<article class="catalog-card" data-controller="catalog-detail">
  <div class="catalog-card__media" data-controller="catalog-image">
    <% if image_source %>
      <%= image_tag image_source, alt: lot.name, loading: "lazy", width: 640, height: 400,
        data: { catalog_image_target: "image", action: "error->catalog-image#fallback" } %>
    <% end %>
    <%= tag.div class: "catalog-card__fallback", hidden: image_source.present?, data: { catalog_image_target: "placeholder" } do %>
      <svg viewBox="0 0 64 48" width="64" height="48" aria-hidden="true" focusable="false">
        <rect x="2" y="2" width="60" height="44" rx="6" fill="none" stroke="currentColor" stroke-width="2"/>
        <circle cx="20" cy="16" r="5" fill="currentColor"/>
        <path d="M8 39 24 25l10 8 9-12 13 18Z" fill="currentColor"/>
      </svg>
      <span>ไม่มีรูปสินค้า</span>
    <% end %>
  </div>
  <div class="catalog-card__details">
    <div class="catalog-card__labels">
      <span class="catalog-card__badge catalog-card__badge--<%= status %>"><%= status_label %></span>
      <span class="catalog-card__badge catalog-card__badge--<%= auction_type %>" aria-label="วิธีประมูล: <%= auction_label %>"><%= auction_label %></span>
    </div>
    <h3><% if destination %><%= link_to lot.name, destination %><% else %><%= lot.name %><% end %></h3>
    <p class="catalog-card__category"><%= lot.category %></p>
    <dl>
      <dt>เริ่มประมูล</dt><dd><time datetime="<%= lot.starts_at.iso8601 %>"><%= lot.starts_at.in_time_zone("Asia/Bangkok").strftime("%d/%m/%Y %H:%M") %></time></dd>
      <dt>ปิดประมูล</dt><dd><time datetime="<%= lot.ends_at.iso8601 %>"><%= lot.ends_at.in_time_zone("Asia/Bangkok").strftime("%d/%m/%Y %H:%M") %></time></dd>
    </dl>
    <div class="catalog-card__footer">
      <% if min_price_cents %>
        <div><span class="catalog-card__price-label">ราคาเริ่มต้น</span><strong class="catalog-card__price"><%= Baht.format(min_price_cents) %> ฿</strong></div>
      <% end %>
      <% if destination %>
        <%= link_to "ดูรายละเอียด ↗", destination, class: "catalog-card__view" %>
      <% else %>
        <button class="catalog-card__view" type="button" data-action="catalog-detail#open">ดูรายละเอียด ↗</button>
      <% end %>
    </div>
  </div>
  <% unless destination %>
    <dialog class="catalog-detail-dialog" aria-labelledby="<%= detail_heading %>" data-catalog-detail-target="dialog" data-action="click->catalog-detail#dismiss">
      <div class="catalog-detail-dialog__body">
        <button type="button" class="catalog-detail-dialog__close" aria-label="ปิดรายละเอียด" data-action="catalog-detail#close">×</button>
        <p class="catalog-eyebrow">AUCTION DETAIL</p>
        <h2 id="<%= detail_heading %>"><%= lot.name %></h2>
        <p><%= lot.category %> · <%= status_label %> · <%= auction_label %></p>
        <% if min_price_cents %><p>ราคาเริ่มต้น <strong><%= Baht.format(min_price_cents) %> ฿</strong></p><% end %>
        <p>ข้อมูลในหน้านี้เป็นข้อมูลตัวอย่าง ไม่ใช่รายการประมูลจริง</p>
        <button type="button" class="catalog-detail-dialog__done" data-action="catalog-detail#close">ปิดหน้าต่าง</button>
      </div>
    </dialog>
  <% end %>
</article>
