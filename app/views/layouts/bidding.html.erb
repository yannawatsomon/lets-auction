<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= [content_for(:title), "Bidding · Lets Auction"].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap">
    <link rel="icon" href="/icon.png" type="image/png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="bidding">
    <header class="bidding-topbar">
      <div class="bidding-topbar__inner">
        <%= link_to bidding_auctions_path, class: "bidding-brand" do %><%= bidding_icon(:gavel, size: 20) %><span>Lets Auction</span><% end %>
        <nav aria-label="Main">
          <%= link_to "Auctions", bidding_auctions_path, "aria-current": (controller_name == "auctions" ? "page" : nil) %>
          <% if current_user&.buyer? %>
            <%= link_to "My invitations", bidding_invitations_path, "aria-current": (controller_name == "invitations" ? "page" : nil) %>
            <%= link_to "My bids", bidding_bids_path, "aria-current": (controller_name == "bids" ? "page" : nil) %>
          <% end %>
        </nav>
        <div class="bidding-who">
          <% if current_user %>
            <% if current_user.buyer? && (grade = BuyerStanding.grade(current_user)) %><span class="bidding-pill"><%= bidding_icon(:shield_check, size: 14) %>Grade <%= grade %></span><% end %>
            <span class="bidding-who__name"><%= current_user.display_name %></span>
            <% if mock_session_enabled? %>
              <%= button_to mock_session_path, method: :delete, class: "bidding-btn", form_class: "bidding-inline" do %><%= bidding_icon(:log_out) %>Sign out (mock)<% end %>
            <% end %>
          <% elsif mock_session_enabled? %>
            <%= link_to "Sign in (mock)", new_mock_session_path, class: "bidding-btn" %>
          <% end %>
        </div>
      </div>
    </header>
    <% if mock_bidding_demo? %>
      <div class="bidding-demo-banner" role="note"><%= bidding_icon(:info, size: 14) %>Demo: every user and auction here is mock data, not a real auction</div>
    <% end %>
    <main class="bidding-page">
      <%= render "bidding/flash" %>
      <%= yield %>
    </main>
  </body>
</html>
