<!DOCTYPE html>
<html lang="th">
  <head>
    <title><%= [content_for(:title), "Bidding แอดมิน · Lets Auction"].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap">
    <link rel="icon" href="/icon.png" type="image/png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="bidding">
    <header class="bidding-topbar">
      <%= link_to admin_bidding_auctions_path, class: "bidding-brand" do %>
        <span>Lets Auction · Bidding</span><span class="bidding-pill">ADMIN</span>
      <% end %>
      <nav aria-label="เมนูแอดมิน">
        <%= link_to "จัดการ Auction", admin_bidding_auctions_path, "aria-current": (controller_name == "auctions" ? "page" : nil) %>
      </nav>
      <div class="bidding-who">
        <span><%= current_user&.display_name %></span>
        <% if mock_login_enabled? %>
          <%= button_to "ออกจากระบบ (mock)", mock_session_path, method: :delete, class: "bidding-btn bidding-btn--link", form_class: "bidding-inline" %>
        <% end %>
      </div>
    </header>
    <main class="bidding-page">
      <%= render "bidding/flash" %>
      <%= yield %>
    </main>
  </body>
</html>
