<!DOCTYPE html>
<html lang="th">
  <head>
    <title><%= [content_for(:title), "Lets Auction"].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@400;500;600;700&display=swap">
    <link rel="icon" href="/icon.png" type="image/png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="ob">
    <%# Look from the team mockup (K-Onboarding); shared tokens live in application.css. %>
    <header class="topbar">
      <%= link_to "Lets Auction", root_path, class: "brand" %>
      <div class="who">
        <span class="ob-autosave">บันทึกทีละขั้น · กลับมาทำต่อได้</span>
        <span><%= current_user&.display_name %></span>
        <% if mock_login_enabled? %>
          <%= button_to "ออกจากระบบ (mock)", mock_session_path, method: :delete, class: "btn link", form_class: "inline" %>
        <% end %>
      </div>
    </header>
    <main class="ob-page">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>
  </body>
</html>
