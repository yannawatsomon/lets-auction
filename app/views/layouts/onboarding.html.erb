<!DOCTYPE html>
<html lang="th">
  <head>
    <title><%= [content_for(:title), "Lets Auction"].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.png" type="image/png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <%# Plain markup on purpose: the team's design system is applied later. %>
    <header>
      <%= link_to "Lets Auction", root_path %>
      <span><%= current_user&.display_name %></span>
      <% if mock_login_enabled? %>
        <%= button_to "ออกจากระบบ (mock)", mock_session_path, method: :delete, form_class: "inline" %>
      <% end %>
    </header>
    <main>
      <%= render "shared/flash" %>
      <%= yield %>
    </main>
  </body>
</html>
