<!DOCTYPE html>
<html lang="th">
  <head>
    <title><%= [content_for(:title), "Product onboarding · Lets Auction"].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap">
    <link rel="icon" href="/icon.png" type="image/png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <header class="topbar">
      <%= link_to product_onboarding_root_path, class: "brand" do %>
        <span>Lets Auction</span><span class="pill-admin">PRODUCT ONBOARDING</span>
      <% end %>
      <div class="who">
        <% if current_user %>
          <span><%= current_user.display_name %> (<%= current_user.role %>)</span>
          <%= button_to "ออกจากระบบ (mock)", mock_session_path, method: :delete, class: "btn link", form_class: "inline" %>
        <% else %>
          <%= link_to "เข้าสู่ระบบจำลอง", new_mock_session_path %>
        <% end %>
      </div>
    </header>
    <main class="page">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>
  </body>
</html>
