<% content_for :title, "ยืนยันตัวตน" %>
<%= render "onboarding/intro" %>
<%= render "onboarding/steps", onboarding: @saved, current: 1 %>

<section class="card ob-card">
  <%= form_with scope: :identity, url: onboarding_identity_path, method: :patch, class: "ob-form" do |f| %>
    <h2>ยืนยันตัวตน</h2>

    <% if @onboarding.errors.any? %>
      <div class="flash alert" role="alert">กรุณาแก้ข้อมูลที่ไม่ถูกต้อง</div>
    <% end %>

    <div class="fields-2">
      <div class="field">
        <%= f.label :national_id, "เลขบัตรประชาชน *" %>
        <% if @saved.completed? %>
          <div class="ob-note" id="identity_national_id">
            <strong><%= ThaiNationalId.mask(@saved.national_id) %></strong><br>
            ยืนยันแล้ว แก้ไขไม่ได้ ถ้าผิดกรุณาติดต่อแอดมิน
          </div>
        <% else %>
          <%# Never echo the ID back into the page (PDPA): the field is always empty. %>
          <%= f.text_field :national_id, value: nil, inputmode: "numeric", autocomplete: "off", maxlength: 17,
                placeholder: "13 หลัก", required: @saved.national_id.blank?,
                "aria-invalid": @onboarding.errors[:national_id].any? %>
          <% if @saved.national_id.present? %>
            <span class="hint">บันทึกไว้แล้ว: <%= ThaiNationalId.mask(@saved.national_id) %> · เว้นว่างไว้ถ้าไม่เปลี่ยน</span>
          <% end %>
        <% end %>
        <% @onboarding.errors[:national_id].each do |m| %><span class="field-error"><%= m %></span><% end %>
      </div>

      <div class="field">
        <%= f.label :phone, "เบอร์มือถือ *" %>
        <%= f.telephone_field :phone, value: params.dig(:identity, :phone) || @saved.phone, autocomplete: "tel",
              placeholder: "08x-xxx-xxxx", required: true, "aria-invalid": @onboarding.errors[:phone].any? %>
        <span class="hint">10 หลัก ขึ้นต้น 06, 08 หรือ 09</span>
        <% @onboarding.errors[:phone].each do |m| %><span class="field-error"><%= m %></span><% end %>
      </div>
    </div>

    <% if @saved.consent_at.nil? %>
      <div class="field">
        <label class="ob-check">
          <%= f.check_box :consent, { "aria-invalid": @onboarding.errors[:consent].any? }, "1", "0" %>
          <span>ฉันยินยอมให้ Lets Auction เก็บและใช้เลขบัตรประชาชน เบอร์โทร และข้อมูลรายได้ เพื่อยืนยันตัวตนและประเมินสิทธิ์การประมูล</span>
        </label>
        <% @onboarding.errors[:consent].each do |m| %><span class="field-error"><%= m %></span><% end %>
      </div>
    <% end %>

    <div class="ob-nav">
      <%= link_to "ย้อนกลับ", onboarding_path, class: "btn" %>
      <%= f.submit "บันทึกและไปต่อ", class: "btn primary" %>
    </div>
  <% end %>
</section>
