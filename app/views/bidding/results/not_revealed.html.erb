<% content_for :title, "Results not published yet" %>
<%= link_to bidding_lot_path(@lot), class: "bidding-btn bidding-btn--link" do %><%= bidding_icon(:arrow_left) %>Back to the lot<% end %>
<div class="bidding-card">
  <span class="bidding-result__eyebrow"><%= bidding_icon(:clock) %>Admin approval</span>
  <h1>Results not published yet</h1>
  <p class="bidding-hint">An admin checks and approves the results after bidding closes. Your bid is safe, and you'll be notified when results are published.</p>
</div>
