<% content_for :title, "Auction result" %>
<%= link_to bidding_lot_path(@lot), class: "bidding-btn bidding-btn--link" do %><%= bidding_icon(:arrow_left) %>Back to the lot<% end %>
<p class="bidding-hint">Results published · Lot <%= @lot.lot_no %> · <%= @lot.item&.title %> · <%= pluralize(@results.size, "bidder") %></p>

<% if @my_offer&.awaiting_payment? %>
  <section class="bidding-card bidding-result bidding-result--win" aria-labelledby="res-h">
    <div class="bidding-result__eyebrow"><%= bidding_icon(:circle_check) %>Congratulations, you can buy this lot<%= " (rank #{@my_offer.rank}: the higher bidder didn't pay or declined)" if @my_offer.rank > 1 %></div>
    <h1 id="res-h"><%= @lot.item&.title %></h1>
    <div class="bidding-stats">
      <div class="bidding-stat"><div class="bidding-stat__k">Your bid (the amount you pay)</div><div class="bidding-stat__v"><%= bidding_baht(@my_offer.amount_cents) %></div></div>
      <div class="bidding-stat"><div class="bidding-stat__k">Pay by</div><div class="bidding-stat__v"><%= bidding_time(@my_offer.payment_due_at) %></div></div>
    </div>
    <p class="bidding-hint">If you don't pay in time, or you decline, the lot goes to the next-highest bidder. Fees, shipping and VAT are calculated at checkout.</p>
    <div class="bidding-actions">
      <%= button_to "Decline", decline_bidding_order_path(@my_offer.id), class: "bidding-btn bidding-btn--danger",
            form: { data: { turbo_confirm: "Decline this lot? This can't be undone." } } %>
      <%= link_to "/payment", class: "bidding-btn bidding-btn--primary" do %>Go to payment<%= bidding_icon(:arrow_right) %><% end %>
    </div>
  </section>
<% elsif @my_offer&.paid? %>
  <section class="bidding-card bidding-result bidding-result--win">
    <div class="bidding-result__eyebrow"><%= bidding_icon(:circle_check) %>Paid</div>
    <h1>Payment received</h1>
    <p class="bidding-hint">The seller will prepare the item for handover.</p>
  </section>
<% else %>
  <section class="bidding-card bidding-result" aria-labelledby="res-h">
    <div class="bidding-result__eyebrow">Auction result</div>
    <h1 id="res-h"><%= @mine ? "You didn't win this lot" : "You didn't bid on this lot" %></h1>
    <% if @mine %>
      <div class="bidding-stats">
        <div class="bidding-stat"><div class="bidding-stat__k">Your bid</div><div class="bidding-stat__v"><%= bidding_baht(@mine.amount_cents) %></div></div>
        <div class="bidding-stat"><div class="bidding-stat__k">Your rank</div><div class="bidding-stat__v"><%= @mine.rank %> of <%= @results.size %></div></div>
      </div>
      <% if @my_offer %>
        <p class="bidding-hint">Your offer: <%= { "expired" => "payment time ran out", "declined" => "you declined" }.fetch(@my_offer.status, @my_offer.status) %></p>
      <% elsif @lot.closed? %>
        <div class="bidding-notice bidding-notice--ok"><%= bidding_icon(:info) %><span>If the winner doesn't pay within 48 hours, you may be offered the lot at your own bid, in rank order.</span></div>
      <% end %>
    <% end %>
    <%= link_to "See other auctions", bidding_auctions_path, class: "bidding-btn" %>
  </section>
<% end %>
