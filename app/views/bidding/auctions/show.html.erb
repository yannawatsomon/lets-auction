<% content_for :title, @auction.title %>
<%= link_to "← กลับไปงานประมูล", bidding_auctions_path, class: "bidding-btn bidding-btn--link" %>

<div class="bidding-row">
  <div style="display:flex;flex-direction:column;gap:16px">
    <div style="display:flex;gap:8px;flex-wrap:wrap"><span class="bidding-chip bidding-chip--type"><%= bidding_type_label(@auction) %></span><%= bidding_status_chip(@auction) %></div>
    <h1><%= @auction.title %></h1>
    <% if @auction.description.present? %><p class="bidding-hint"><%= @auction.description %></p><% end %>
    <div class="bidding-stats">
      <div class="bidding-stat"><div class="bidding-stat__k">เริ่มประมูล</div><div class="bidding-stat__v"><%= bidding_time(@auction.starts_at) %></div></div>
      <div class="bidding-stat"><div class="bidding-stat__k">ปิดประมูล</div><div class="bidding-stat__v"><%= bidding_time(@auction.ends_at) %></div></div>
    </div>
  </div>

  <aside class="bidding-card" aria-labelledby="join-h">
    <h2 id="join-h">การเข้าร่วม</h2>
    <% if current_user.nil? %>
      <div class="bidding-notice bidding-notice--warn">เข้าสู่ระบบก่อนเพื่อดูว่าคุณเข้าร่วมงานนี้ได้ไหม</div>
      <% if mock_login_enabled? %><%= link_to "เข้าสู่ระบบ", new_mock_session_path, class: "bidding-btn bidding-btn--primary" %><% end %>
    <% elsif @participant&.registered? || @participant&.accepted? %>
      <div class="bidding-notice bidding-notice--ok"><strong>คุณเข้าร่วมงานนี้แล้ว</strong> · ยื่นราคาได้เมื่องานเริ่ม</div>
    <% elsif @participant&.invited? %>
      <div class="bidding-notice bidding-notice--ok"><strong>คุณได้รับเชิญ</strong> · ตอบรับก่อนจึงจะเสนอราคาได้</div>
      <%= button_to "ตอบรับคำเชิญ", accept_bidding_invitation_path(@participant), class: "bidding-btn bidding-btn--primary" %>
    <% elsif @participant&.revoked? %>
      <div class="bidding-notice bidding-notice--warn">สิทธิ์เข้าร่วมงานนี้ถูกยกเลิกแล้ว ติดต่อแอดมินถ้าคิดว่าผิดพลาด</div>
    <% elsif @ineligible %>
      <div class="bidding-notice bidding-notice--warn"><strong>ยังเข้าร่วมไม่ได้</strong> · <%= @ineligible.message %></div>
    <% elsif @auction.sealed_first_price? && (@auction.scheduled? || @auction.live?) %>
      <div class="bidding-notice bidding-notice--ok"><strong>คุณมีสิทธิ์เข้าร่วม</strong> · เกรด <%= BuyerStanding.grade(current_user) %> · ยื่นซองได้ 1 ครั้งต่อสินค้า แก้ไขไม่ได้</div>
      <%= button_to "ลงทะเบียนเข้าร่วมงาน", bidding_auction_registration_path(@auction), class: "bidding-btn bidding-btn--primary" %>
    <% else %>
      <div class="bidding-notice bidding-notice--warn">งานนี้ไม่เปิดรับลงทะเบียนแล้ว</div>
    <% end %>
  </aside>
</div>

<section class="bidding-card" aria-labelledby="lots-h">
  <h2 id="lots-h">สินค้าในงาน</h2>
  <% @auction.lots.each do |lot| %>
    <div class="bidding-pick">
      <span class="bidding-pick__thumb" aria-hidden="true"></span>
      <span class="bidding-pick__body">
        <span class="bidding-pick__title">ล็อต <%= lot.lot_no %> · <%= lot.item&.title || "สินค้า ##{lot.item_id}" %></span>
        <span class="bidding-pick__sub"><%= lot.item&.category %> · ราคาเริ่มต้นขั้นต่ำ <%= bidding_baht(lot.min_price_cents) %></span>
      </span>
    </div>
  <% end %>
</section>
