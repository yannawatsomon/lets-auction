<% content_for :title, "Auctions" %>
<div class="bidding-stack">
  <h1>Auctions</h1>
  <p class="bidding-hint">Sealed-bid auctions open for registration. English auctions are invite only; find them under “My invitations”.</p>
</div>

<% if @auctions.empty? %>
  <div class="bidding-card"><p class="bidding-hint">No open auctions yet.</p></div>
<% else %>
  <div class="bidding-cards">
    <% @auctions.each do |a| %>
      <article class="bidding-card">
        <%= link_to bidding_auction_path(a), class: "bidding-cover" do %>
          <div class="bidding-cover__img" aria-hidden="true"><%= bidding_icon(:image, size: 24) %></div>
          <div class="bidding-cover__body">
            <div class="bidding-badges"><span class="bidding-chip bidding-chip--type"><%= bidding_type_label(a) %></span><%= bidding_status_chip(a) %></div>
            <h2><%= a.title %></h2>
            <span class="bidding-hint"><%= bidding_time(a.starts_at) %> – <%= bidding_time(a.ends_at) %> · <%= pluralize(a.lots.size, "lot") %></span>
          </div>
        <% end %>
      </article>
    <% end %>
  </div>
<% end %>

<nav class="bidding-actions" aria-label="Pages">
  <% if @page > 1 %><%= link_to bidding_auctions_path(page: @page - 1), class: "bidding-btn" do %><%= bidding_icon(:arrow_left) %>Previous<% end %><% end %>
  <% if @next_page %><%= link_to bidding_auctions_path(page: @page + 1), class: "bidding-btn" do %>Next<%= bidding_icon(:arrow_right) %><% end %><% end %>
</nav>
