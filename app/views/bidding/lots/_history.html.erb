<%# English bid history (#34): newest first, bidders masked, your own bids say "You". %>
<ol class="bidding-history" aria-label="Bid history">
  <% if history.rows.empty? %>
    <li class="bidding-hint">No bids yet</li>
  <% end %>
  <% history.rows.each do |row| %>
    <li class="bidding-history__row <%= 'bidding-history__row--mine' if row.mine %>">
      <span class="bidding-history__who"><%= row.bidder || "Bidder" %></span>
      <span><%= bidding_baht(row.amount_cents) %></span>
      <time class="bidding-hint bidding-mono" datetime="<%= row.placed_at.iso8601(3) %>"><%= row.placed_at.in_time_zone.strftime("%H:%M:%S") %></time>
    </li>
  <% end %>
</ol>
<% if history.page > 1 || history.next_page? %>
  <nav class="bidding-actions" aria-label="History pages">
    <% if history.page > 1 %><%= link_to bidding_lot_path(lot, history_page: history.page - 1), class: "bidding-btn" do %><%= bidding_icon(:arrow_left) %>Newer<% end %><% end %>
    <% if history.next_page? %><%= link_to bidding_lot_path(lot, history_page: history.page + 1), class: "bidding-btn" do %>Older<%= bidding_icon(:arrow_right) %><% end %><% end %>
  </nav>
<% end %>
