<%# English live bid room (#32 form, #34 live updates), mockup B05.
    The page renders the current state; bidding-live-lot keeps it fresh from AuctionChannel. %>
<% leading = @lot.leader_bid&.user_id == current_user&.id && current_user.present? %>
<% open = @lot.accepting_bids?(@now) %>
<% can_bid = @participant&.accepted? %>
<% deadline = @now < @auction.starts_at ? @auction.starts_at : @auction.ends_at %>
<div class="bidding-live" data-controller="bidding-live-lot"
     data-bidding-live-lot-auction-id-value="<%= @auction.id %>"
     data-bidding-live-lot-lot-id-value="<%= @lot.id %>"
     data-bidding-live-lot-my-label-value="<%= @history&.viewer_label %>"
     data-bidding-live-lot-history-url-value="<%= bids_bidding_lot_path(@lot) %>"
     data-bidding-live-lot-can-bid-value="<%= can_bid && open ? 'true' : 'false' %>">
  <section class="bidding-card" aria-labelledby="eng-h">
    <div class="bidding-head">
      <h2 id="eng-h">
        <% if open %><span class="bidding-chip bidding-chip--live" data-bidding-live-lot-target="liveChip"><span class="bidding-live-dot" aria-hidden="true"></span>Live</span><% else %>English auction<% end %>
      </h2>
      <span class="bidding-hint"><%= @now < @auction.starts_at ? "Opens in" : "Closes in" %>
        <strong class="bidding-mono" data-controller="bidding-countdown" data-bidding-countdown-deadline-value="<%= deadline.iso8601 %>" data-bidding-countdown-server-time-value="<%= @now.iso8601(3) %>"><%= bidding_time(deadline) %></strong>
      </span>
    </div>

    <div class="bidding-stack" aria-live="polite">
      <div>
        <div class="bidding-hint" data-bidding-live-lot-target="priceLabel"><%= @lot.bid_count.zero? ? "Starting price" : "Current price" %></div>
        <div class="bidding-amount-big" data-bidding-live-lot-target="price"><%= bidding_baht(@lot.bid_count.zero? ? @lot.min_price_cents : @lot.current_price_cents) %></div>
      </div>
      <div class="bidding-ok-title" data-bidding-live-lot-target="leading" <%= "hidden" unless leading %>><%= bidding_icon(:circle_check) %><strong>You're the highest bidder</strong></div>
      <div class="bidding-notice bidding-notice--warn" data-bidding-live-lot-target="outbid" hidden><%= bidding_icon(:alert) %><span>Someone outbid you. You can bid again below.</span></div>
      <div class="bidding-hint" data-bidding-live-lot-target="leader"><%= "Leader: #{Bidding::Broadcaster.masked_leader(@lot)}" if @lot.leader_bid %></div>
    </div>

    <div class="bidding-stats">
      <div class="bidding-stat"><div class="bidding-stat__k">Bid increment</div><div class="bidding-stat__v"><%= bidding_baht(@lot.bid_increment_cents) %></div></div>
      <div class="bidding-stat"><div class="bidding-stat__k">Bids so far</div><div class="bidding-stat__v"><span data-bidding-live-lot-target="count"><%= @lot.bid_count %></span></div></div>
    </div>

    <div class="bidding-notice bidding-notice--warn" data-bidding-live-lot-target="closed" <%= "hidden" unless !open && @now >= @auction.starts_at %>><%= bidding_icon(:clock) %><span>Bidding is closed. Waiting for an admin to publish results.</span></div>

    <% if current_user.nil? %>
      <div class="bidding-notice bidding-notice--warn"><%= bidding_icon(:alert) %><span>Sign in to bid.</span></div>
    <% elsif @participant&.invited? %>
      <div class="bidding-notice bidding-notice--warn"><%= bidding_icon(:alert) %><span>Accept the invitation before you bid.</span></div>
      <%= button_to "Accept invitation", accept_bidding_invitation_path(@participant), class: "bidding-btn bidding-btn--primary" %>
    <% elsif !can_bid %>
      <div class="bidding-notice bidding-notice--warn"><%= bidding_icon(:alert) %><span>This auction is open to invited buyers only.</span></div>
    <% elsif @now < @auction.starts_at %>
      <div class="bidding-notice bidding-notice--warn"><%= bidding_icon(:clock) %><span>Bidding hasn't opened yet.</span></div>
    <% elsif open %>
      <%= form_with url: bidding_lot_bids_path(@lot), method: :post, class: "bidding-field", data: { turbo_confirm: "Place this bid? You can't cancel it.", bidding_live_lot_target: "form" }, html: { hidden: leading } do %>
        <%= hidden_field_tag :idempotency_key, @idempotency_key %>
        <label for="eng-amount">Your bid (THB)</label>
        <input id="eng-amount" name="amount" inputmode="decimal" autocomplete="off" required class="bidding-amount-input"
          value="<%= Baht.format(@lot.next_minimum_cents) %>" aria-describedby="eng-hint" data-bidding-live-lot-target="amount">
        <span id="eng-hint" class="bidding-hint">Minimum this time <span class="bidding-mono" data-bidding-live-lot-target="nextMin"><%= bidding_baht(@lot.next_minimum_cents) %></span> · bids can't be cancelled</span>
        <button class="bidding-btn bidding-btn--primary bidding-btn--big">Place bid</button>
      <% end %>
    <% end %>
    <p class="bidding-hint">Closes on time, no extensions · the leader can't bid again · the winner pays within 48 hours</p>
    <p class="bidding-hint" data-bidding-live-lot-target="status" aria-live="polite"></p>
  </section>

  <section class="bidding-card" aria-labelledby="hist-h">
    <h2 id="hist-h">Bid history</h2>
    <div data-bidding-live-lot-target="history">
      <%= render "bidding/lots/history", lot: @lot, history: @history %>
    </div>
  </section>
</div>
