<% content_for :title, "My invitations" %>
<div class="bidding-stack">
  <h1>My invitations</h1>
  <p class="bidding-hint">English auctions are open only to buyers an admin invites. Accept an invitation before you bid.</p>
</div>

<div class="bidding-card">
  <% if @invitations.empty? %>
    <p class="bidding-hint">No invitations yet.</p>
  <% end %>
  <% @invitations.each do |inv| %>
    <div class="bidding-pick">
      <span class="bidding-pick__body">
        <span class="bidding-pick__title"><%= link_to inv.auction.title, bidding_auction_path(inv.auction) %></span>
        <span class="bidding-pick__sub"><%= bidding_time(inv.auction.starts_at) %> – <%= bidding_time(inv.auction.ends_at) %> · <%= inv.accepted? ? "Accepted" : "Waiting for you" %></span>
      </span>
      <% if inv.invited? %><%= button_to "Accept", accept_bidding_invitation_path(inv), class: "bidding-btn bidding-btn--primary" %><% end %>
    </div>
  <% end %>
</div>
