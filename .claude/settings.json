{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push --delete*)",
      "Bash(git push -d*)",
      "Bash(git push * --delete*)",
      "Bash(git push * -d *)",
      "Bash(git push * :*)",
      "Bash(gh api -X DELETE*)",
      "Bash(gh api --method DELETE*)",
      "Bash(gh api * -X DELETE*)",
      "Bash(gh api * --method DELETE*)"
    ],
    "ask": [
      "Bash(gh pr merge*)",
      "Bash(gh repo edit*)",
      "Bash(gh repo delete*)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(railway)",
      "Bash(railway *)",
      "Bash(kamal *)",
      "Bash(bin/kamal *)",
      "Bash(*RAILS_ENV=production*)"
    ]
  }
}
